{
  "manifest_version": 3,
  "name": "网页图片和视频下载",
  "version": "1.0.0",
  "description": "找出当前网页里的图片和可直接下载的视频，勾选后保存到电脑。",
  "permissions": ["activeTab", "scripting", "downloads", "contextMenus", "storage"],
  "action": {
    "default_title": "网页图片和视频下载",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["drag-download.js"],
    "all_frames": true
  }],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
